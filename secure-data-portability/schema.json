{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable User Data Export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "user_id",
    "full_name",
    "email",
    "phone",
    "signup_date",
    "preferences"
  ],
  "properties": {
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "full_name": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "minLength": 3
    },
    "phone": {
      "type": "string",
      "minLength": 1
    },
    "signup_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "preferences": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
