digraph DataFlow {
  rankdir=LR;
  graph [label="Cross-Border HR Data Flow", labelloc=t, fontsize=18];
  node [shape=box, style="rounded", fontsize=11];
  edge [fontsize=10];

  dubai [label="Dubai HR Controller\\nDubai, United Arab Emirates\\nUAE HR Information System"];
  frankfurt [label="Frankfurt Payroll Processor\\nFrankfurt, Germany\\nEU Payroll Processing Platform"];

  dubai -> frankfurt [label="Monthly HR / payroll transfer\nTLS 1.3"];
  subprocessor_1 [label="Riyadh Payroll Support Services\\nRiyadh, Saudi Arabia\\nRegional payroll support and exception handling"];
  frankfurt -> subprocessor_1 [label="Onward transfer\nTLS 1.3\nGDPR Chapter V assessment"];
}
